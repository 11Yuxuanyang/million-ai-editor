# Track only the 百万AI剪辑师 control plane and small metadata.
/*
!/.gitignore
!/.rgignore
!/README.md
!/README_EN.md
!/AGENTS.md
!/INDEX.md
!/LICENSE
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/.github/
!/config/
!/docs/
!/system/
!/skills/
!/episodes/
!/shoots/
!/library/
!/publishing/
!/wiki/
!/legacy-map/
!/references/
!/pyproject.toml
!/uv.lock

# Session status is local and may be changed by concurrent editing tasks.
/NOW.md

# Stable production contracts only; legacy archive-control files stay local.
/config/*
!/config/editorial-defaults.json
!/config/environment.lock.json
!/config/episode.template.json
!/config/creative-brief.template.json
!/config/sequence-plan.template.json
!/config/asset-policy.json
!/config/machine.example.json
!/config/profiles/
!/config/profiles/*.json

# Only current, human-authored collaboration documents belong in the repo.
/docs/*
!/docs/EDITORIAL-MOTHER.md
!/docs/CONTRIBUTOR-GUIDE.md
!/docs/OPEN-SOURCE-LAUNCH-SCRIPT.md
!/docs/assets/
!/docs/assets/star-history.svg
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/OVERVIEW.md
!/docs/architecture/PARALLEL-ARCHITECTURE.md
!/docs/research/
/docs/research/*
!/docs/research/2026-08-20-viral-ae-youtube-sfx.md
!/docs/research/multi-platform-publishing-apis-2026-08-05.md
/docs/plans/

# The old control-plane state and tests are local history, not editing runtime.
/system/*
!/system/scripts/
/system/scripts/*
!/system/scripts/install-local-skills.sh
!/system/scripts/editctl.py
!/system/scripts/assetctl.py
!/system/assets/
!/system/assets/*.py
!/system/editing/
!/system/editing/*.py
!/system/schemas/
!/system/schemas/*.json
!/system/tests/
/system/tests/*
!/system/tests/test_editctl.py
!/system/tests/test_asset_*.py
!/system/templates/
/system/templates/*
!/system/templates/hyperframe-episode/
!/system/templates/hyperframe-episode/*
!/system/templates/reference-card/
!/system/templates/reference-card/*
!/system/templates/episode-AGENTS.md

# Keep reusable visual techniques and the current taste release; catalog runs are rebuildable.
/library/*
!/library/techniques/
!/library/taste/
!/library/references/
!/library/references/**/
!/library/references/**/*.json
!/library/references/**/*.yaml
!/library/references/**/*.jpg
/library/catalog/current/

# Existing reference compatibility: keep only canonical text, registries, and code.
/references/*
!/references/SHOT-LANGUAGE.md
!/references/asset-library/
/references/asset-library/*
!/references/asset-library/README.md
!/references/asset-library/registry.json
!/references/asset-library/motion-recipes/
!/references/asset-library/overlays/
!/references/asset-library/sfx/
!/references/asset-library/lottie/
!/references/asset-library/previews/
!/references/asset-library/reviews/

# Publishing packages and runtime logs are generated or contain media.
/publishing/douyin-queue.json
!/publishing/douyin-queue.example.json
/publishing/packages/
/publishing/logs/

# Episode working data is rebuildable and never belongs in Git.
/episodes/*
!/episodes/README.md
!/episodes/reference/
!/episodes/reference/**
**/90-work/
**/.work/
**/.cache/
**/.venv/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.DS_Store

# Large media and generated previews stay on disk but outside Git history.
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.avi
**/*.wav
**/*.mp3
**/*.m4a
**/*.aac
**/*.flac
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.avif
**/*.lottie
**/*.zip
**/*.tar
**/*.gz

# Small licensed motion primitives are system dependencies, not episode source media.
!/references/asset-library/overlays/film-burn-red-orange-screen-v1.mp4
!/references/asset-library/sfx/camera-shutter-jdaniel1999-376205.wav

# Never version credentials, even in a private repository.
**/.env
**/.env.*
**/*credentials*.json
**/*secret*.json
**/*.pem
**/*.key

# Curated, low-resolution visual references are part of the handoff.
!/episodes/**/reference/
!/episodes/**/reference/*.png
!/episodes/**/reference/*.jpg
!/episodes/**/reference/*.jpeg
!/episodes/reference/0813-yujun-boss-content-memory/reference/case-demo-20s-720p60.mp4
!/episodes/reference/0813-yujun-boss-content-memory/reference/case-demo-preview-6s.gif
!/library/references/**/*.jpg
!/references/asset-library/previews/*.png

# Cached visual indexes are rebuildable; their JSON cards remain tracked.
/library/media/previews/
